<Project>
  <PropertyGroup>
    <!--
      The released tag and the binary have to agree, so the number lives here and nowhere else.
      The SDK appends the commit to AssemblyInformationalVersion by itself, which is what the
      deletion log records; the window title shows the three-part number alone.
    -->
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
