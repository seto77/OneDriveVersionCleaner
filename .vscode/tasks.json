{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build OneDriveVersionCleaner (WinForms)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/OneDriveVersionCleaner.App/OneDriveVersionCleaner.App.csproj",
        "--configuration",
        "Debug",
        "--verbosity",
        "minimal"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
