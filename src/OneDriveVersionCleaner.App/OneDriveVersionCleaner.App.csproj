<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>OneDriveVersionCleaner</AssemblyName>
    <RootNamespace>OneDriveVersionCleaner.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OneDriveVersionCleaner.Core\OneDriveVersionCleaner.Core.csproj" />
    <ProjectReference Include="..\OneDriveVersionCleaner.Infrastructure\OneDriveVersionCleaner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OneDriveVersionCleaner.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Makes the visual designer the default view for the forms and nests their generated code. -->
  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="MainForm.Localization.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="DeleteConfirmationForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DeleteConfirmationForm.Designer.cs">
      <DependentUpon>DeleteConfirmationForm.cs</DependentUpon>
    </Compile>
    <Compile Update="SharePointSignInForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="SharePointSignInForm.Designer.cs">
      <DependentUpon>SharePointSignInForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- The unused WebView2 WPF reference is dropped for every project by Directory.Build.targets. -->

</Project>
